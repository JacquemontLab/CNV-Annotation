manifest {
    name        = 'CNV-Annotation'
    author      = 'Benjamin Clark and Florian Bénitière'
    description = 'Nextflow pipeline for annotating CNV. Only requires CNV positions, type and SampleID.'
    version     = '2.0.0'
}


profiles {
    
    // Test profile
    test {
        params {
            cnvs = "${projectDir}/tests/cnvs_10k.tsv"
            dataset_name = "Testing"
        }
    }

    // Apptainer containers
    apptainer {
        apptainer.enabled = true
        process  {
            container = 'docker://ghcr.io/jacquemontlab/python_packages:latest'

            withLabel: vep {
                container = 'docker://ghcr.io/jacquemontlab/ensembl_113:latest'
                }
            
            withLabel: Rmarkdown {
                container = 'docker://ghcr.io/jacquemontlab/cnv_dataset_report:latest'
            }
        }
    }

    // Singularity containers
    singularity {
        singularity.enabled = true
        process  {
            container = 'docker://ghcr.io/jacquemontlab/python_packages:latest'

            withLabel: vep {
                container = 'docker://ghcr.io/jacquemontlab/ensembl_113:latest'
                }
            
            withLabel: Rmarkdown {
                container = 'docker://ghcr.io/jacquemontlab/cnv_dataset_report:latest'
            }
        }
    }

    // Docker containers
    docker {
        docker.enabled = true
        process  {
            container = 'ghcr.io/jacquemontlab/python_packages:latest'

            withLabel: vep {
                container = 'ghcr.io/jacquemontlab/ensembl_113:latest'
                }
            
            withLabel: Rmarkdown {
                container = 'ghcr.io/jacquemontlab/cnv_dataset_report:latest'
            }
        }
    }

    // Conda environment
    // But problem with duckdb from bash that is not rightly installed with mamba
    // curl -L https://github.com/duckdb/duckdb/releases/latest/download/duckdb-linux-amd64.zip -o duckdb.zip
    // unzip duckdb.zip
    // chmod +x duckdb
    conda {
        conda {
            enabled = true
            useMamba = false
            autoMounts = true
            channels = ['conda-forge', 'bioconda', 'default']
        }

        process {        
            conda = "conda-forge::duckdb conda-forge::python-duckdb conda-forge::pyarrow conda-forge::pandas conda-forge::polars conda-forge::matplotlib"

            withLabel: vep {
                conda = 'bioconda::ensembl-vep=113.4'
                }

            withLabel: Rmarkdown {
                conda = '''
                conda-forge::r-rmarkdown
                conda-forge::r-knitr
                conda-forge::r-ggplot2
                conda-forge::r-dplyr
                conda-forge::r-tidyr
                conda-forge::r-stringr
                conda-forge::r-patchwork
                conda-forge::r-viridis
                conda-forge::r-scales
                conda-forge::r-rlang
                conda-forge::r-tidyverse
                conda-forge::r-ggh4x
                conda-forge::r-arrow
                conda-forge::r-duckdb
                conda-forge::r-readxl
                conda-forge::pandoc
                conda-forge::texlive-core
                conda-forge::fonttools
                genomedk::tinytex
                '''
            }
        }
    }
}
