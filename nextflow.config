manifest {
    name        = 'CNV-Annotation'
    author      = 'Benjamin Clark and Florian Bénitière'
    description = 'Nextflow pipeline for annotating CNV. Only requires CNV positions, type and SampleID.'
    version     = '2.0.0'
}

profiles {
    test {
        docker.enabled = true

        process  {
            container = 'ghcr.io/jacquemontlab/python_etl_packages:latest'
        }

        params {
            cnvs = "${projectDir}/tests/cnvs_10k.tsv"
            genome_version = 'GRCh38'
            cohort_tag = "Testing"
        }
    }
}