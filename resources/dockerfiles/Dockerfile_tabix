# Base image with bash
FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies for CNV-Annotation
RUN apt-get update && apt-get install -y \
    curl \
    git \
    perl \
    tabix \
    wget \
    unzip \
    gzip \
    tar \
    bcftools \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Create a home directory with .bashrc
ENV HOME=/root
RUN touch $HOME/.bashrc

# Add a bin directory for nextflow
RUN mkdir -p $HOME/bin
ENV PATH="$HOME/bin:$PATH"

# Set working directory for CNV-Annotation
WORKDIR /CNV-Annotation

# Copy INSTALL.sh into the container (optional)
# COPY INSTALL.sh .

# Default command
CMD ["/bin/bash"]
