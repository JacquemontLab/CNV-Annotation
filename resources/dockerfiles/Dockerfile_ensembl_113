# Use the Ensembl VEP release 113.3 image
FROM ensemblorg/ensembl-vep:release_113.3

# Switch to root to install system packages
USER root

# Install system dependencies for VEP + unpacking BioPerl
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    perl \
    tabix \
    build-essential \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    libncurses5-dev \
    libncursesw5-dev \
    libssl-dev \
    libdbi-perl \
    libdbd-mysql-perl \
    libjson-perl \
    libarchive-zip-perl \
    libxml-simple-perl \
    cpanminus \
    libcurl4-openssl-dev \
    parallel \
    ca-certificates \
    pkg-config \
    libtool \
    unzip \
    tar \
    gzip \
    pigz \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user and switch to it
RUN useradd -m -u 1000 flben

USER flben

# Default working directory and shell
WORKDIR /data
SHELL ["/bin/bash", "-c"]
CMD ["bash"]
