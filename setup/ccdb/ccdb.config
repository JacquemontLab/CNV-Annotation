

//defining static resource file paths which are consistent across all runs
params {
    vep_cache  = "/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/VEP/cache"
}

apptainer {
    enabled = true
    autoMounts = true
} 


process {
    executor = 'local'
    module = 'apptainer/1.3.5'
    container = '/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/Dockers/python_packages_latest.sif'
    cpus = 64

    withLabel: Rmarkdown {
        container = '/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/Dockers/cnv_dataset_report_latest.sif'
    }
    
    withLabel: vep {
        executor = 'local'
        module = ['apptainer/1.3.5', 'htslib/1.19']
        container = '/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/Dockers/ensembl_113_latest.sif'
        }
}

//Default OOM Error strategy
maxRetries = 4
errorStrategy = { task.exitStatus in [125,139] ? 'retry' : 'finish' }
memory = { check_max( 4.GB * task.attempt, 'memory' ) }





