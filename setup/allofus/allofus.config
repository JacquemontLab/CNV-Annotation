
conda {
    enabled = true
    useMamba = false
    autoMounts = true
    channels = ['conda-forge', 'bioconda', 'default']
}

process {
    executor = 'local'
    cpus     = 32
    memory   = '100G'
  
  conda = "conda-forge::duckdb conda-forge::python-duckdb conda-forge::pyarrow conda-forge::pandas conda-forge::polars conda-forge::matplotlib"

  withLabel: vep {
	  conda = 'bioconda::ensembl-vep=113.4'
	}

    withLabel: Rmarkdown {
        conda = 'conda-forge::r-rmarkdown conda-forge::r-knitr conda-forge::r-ggplot2 conda-forge::r-dplyr conda-forge::r-tidyr conda-forge::r-stringr conda-forge::r-patchwork conda-forge::r-viridis conda-forge::r-scales conda-forge::r-rlang conda-forge::r-tidyverse conda-forge::r-ggh4x conda-forge::r-arrow conda-forge::r-duckdb conda-forge::r-readxl conda-forge::pandoc conda-forge::fonttools genomedk::tinytex'
    }

}

